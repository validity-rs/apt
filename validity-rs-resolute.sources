# validity-rs APT repository for Ubuntu 26.04 LTS (resolute): validity-daemon and its
# companions. Installed by validity-rs-archive-keyring. The key in Signed-By is
# trusted for this repository only: it cannot sign for any other source.
Types: deb
URIs: https://validity-rs.github.io/apt
Suites: resolute
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/validity-rs-archive-keyring.gpg
